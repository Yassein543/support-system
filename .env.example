# Copy these variable names into your local .env or Vercel project settings.
# Keep the real API key private; never put it in browser code.
# The website AI assistant uses Gemini when GEMINI_API_KEY is configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
BOT_API_URL=https://ys-bot.vercel.app
BOT_API_SECRET=
SESSION_SECRET=
