{
  "name": "ys-bot-lab",
  "productName": "YS Bot Lab",
  "version": "1.0.9",
  "private": true,
  "author": "YS-Bot",
  "description": "Local AI coding workspace for Discord bots and general projects",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dist:windows": "electron-builder --win nsis --publish never",
    "dist:portable": "electron-builder --win portable -c.artifactName=YS-Bot-Lab-Portable-${version}.${ext}"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "ffmpeg-static": "^5.3.0"
  },
  "build": {
    "appId": "com.ysbot.lab",
    "productName": "YS Bot Lab",
    "asar": true,
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      }
    ],
    "files": [
      "desktop/main.js",
      "desktop/preload.js",
      "server.js",
      "index.html",
      "assets/**",
      "package.json"
    ],
    "directories": {
      "output": "dist-v109"
    },
    "win": {
      "icon": "assets/ys-bot-lab.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false
    },
    "artifactName": "YS-Bot-Lab-Setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "Yassein543",
      "repo": "support-system",
      "releaseType": "release"
    }
  }
}
