{
  "version": 2,
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "*.html",
          "*.css",
          "ys-bot-avatar.svg",
          "emojis/*.svg",
          "button-effects.js",
          "services/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)\\.(css|js|png|jpg|jpeg|gif|svg|ico)",
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "app.js"
    }
  ]
}
