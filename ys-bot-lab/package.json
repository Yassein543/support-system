{
  "name": "ys-bot-lab",
  "productName": "YS Bot Lab",
  "version": "1.0.1",
  "private": true,
  "author": "YS-Bot",
  "description": "Local AI coding workspace for Discord bots and general projects",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dist:windows": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable -c.artifactName=YS-Bot-Lab-Portable-${version}.${ext}"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.ysbot.lab",
    "productName": "YS Bot Lab",
    "asar": true,
    "files": [
      "desktop/main.js",
      "desktop/preload.js",
      "server.js",
      "index.html",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false
    },
    "artifactName": "YS-Bot-Lab-Setup-${version}.${ext}"
  }
}
